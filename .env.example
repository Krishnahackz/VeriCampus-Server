# Render supplies this automatically when using a PostgreSQL database.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/vericampus

# Server
PORT=5000
NODE_ENV=production

# Frontend URL(s), comma-separated if more than one
# Example: https://vericampus.vercel.app,http://localhost:5000
FRONTEND_URL=https://YOUR-VERICAMPUS.vercel.app

# REQUIRED: generate a random secret of at least 32 characters.
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters

# REQUIRED to create the first two teacher/admin accounts.
TEACHER_REGISTRATION_KEY=replace_with_a_long_private_registration_key

# Gmail SMTP App Password
MAIL_USER=your_college_gmail@gmail.com
MAIL_APP_PASSWORD=your_16_character_gmail_app_password

# Optional: receive new-student notifications here
ADMIN_EMAIL=your_admin_email@gmail.com
